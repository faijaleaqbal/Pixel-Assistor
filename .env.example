# ─── Required ────────────────────────────────────────────────
TOKEN=
CLIENT_ID=
OWNER_ID=
GUILD_ID=

# ─── Optional — bot behaviour ───────────────────────────────
PREFIX=?
EMBED_COLOR=7C3AED
HELP_FOOTER_NAME=
DEFAULT_COOLDOWN=3
DEPLOY_MANAGER=pm2

# ─── Optional — Help menu custom emojis ─────────────────────
# Paste full Discord emoji strings e.g. "<:spacer:1234567890123456789>"
# spacer = transparent/blank PNG (creates hanging-indent), chevron = grey ">" arrow icon.
# Leave empty to use plain unicode fallbacks.
EMOJI_SPACER=
EMOJI_CHEVRON=
EMOJI_AUTOMOD=
EMOJI_KING=

# ─── Optional — database ────────────────────────────────────
# SQLite is the default; MongoDB is used only if MONGO_URI is set.
DB_SQLITE_PATH=./data/bot.db
MONGO_URI=

# ─── Optional — crypto APIs (all individually optional) ─────
# CoinGecko (works without a key on the free tier, but a demo key is recommended)
COINGECKO_API_KEY=
COINGECKO_DEMO_API_KEY=

# Etherscan-family explorers (Polygon / BNB / Ethereum share the same API shape).
# BSCSCAN_API_KEY and ETHERSCAN_API_KEY fall back to POLYGONSCAN_API_KEY if unset.
POLYGONSCAN_API_KEY=
BSCSCAN_API_KEY=
ETHERSCAN_API_KEY=

# Tron (TRX + TRC20 USDT)
TRONGRID_API_KEY=

# Solana (Helius enhanced API + RPC)
HELIUS_API_KEY=

# Litecoin + BTC (BlockCypher)
BLOCKCYPHER_TOKEN=

# Free FX rates API (defaults to open.er-api.com — no key required)
FX_API_BASE=https://open.er-api.com/v6

# ─── Optional — Last.fm ──────────────────────────────────────
LASTFM_API_KEY=

# ─── Optional — Lavalink ─────────────────────────────────────
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# ─── Optional — additional bot owners (comma-separated) ─────
OWNER_IDS=

# ─── Optional — transcript viewer service (separate process) ──────
# VIEWER_BASE_URL: Public URL where the viewer is reachable (e.g. "http://123.45.67.89:3847")
# VIEWER_PORT: Port for the viewer Express server (default 3847)
VIEWER_BASE_URL=
VIEWER_PORT=3847
